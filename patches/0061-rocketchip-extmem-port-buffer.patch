+          := TLBuffer()
+          := mem_bypass_xbar
+          := _
+        )
+      }
+    } else {
     mbus.coupleTo(s"memory_controller_port_named_$portName") {
       // Disable monitors on this connection since the class with this trait (i.e. DigitalTop) doesn't provide an
       // implicit clock for the monitor.
