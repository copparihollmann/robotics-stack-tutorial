-  io.schedule.bits.c.valid := (!s_release && w_rprobeackfirst) || (!s_probeack && w_pprobeackfirst)
+  // InclusiveCacheSkipCleanRelease: a clean victim gets its Directory invalidate (dir.valid below
+  // is unchanged) but no outer Release; w_releaseack is set when that schedule fires.
+  if (skipCleanRelease) {
+    io.schedule.bits.c.valid := (!s_release && w_rprobeackfirst && meta.dirty) || (!s_probeack && w_pprobeackfirst)
+  } else {
+    io.schedule.bits.c.valid := (!s_release && w_rprobeackfirst) || (!s_probeack && w_pprobeackfirst)
+  }
   io.schedule.bits.d.valid := !s_execute && w_pprobeack && w_grant
   io.schedule.bits.e.valid := !s_grantack && w_grantfirst
   io.schedule.bits.x.valid := !s_flush && w_releaseack
@@ -211,6 +222,11 @@
     }
   }
 
+  if (skipCleanRelease) {
+    // The Release a clean victim would have sent is never sent, so nothing will ack it.
+    when (io.schedule.ready && !s_release && w_rprobeackfirst && !meta.dirty) { w_releaseack := true.B }
