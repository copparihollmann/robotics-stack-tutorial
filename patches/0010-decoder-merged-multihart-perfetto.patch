 use serde_json::json;
 use log::debug;
 
+/// Which Perfetto track a decoded trace's slices belong to.
+///
+/// Chrome/Perfetto JSON has no separate notion of a track: a track IS the `(pid, tid)`
+/// pair carried on every event, and its NAME comes from two `"ph":"M"` metadata events
+/// (`process_name`, `thread_name`) that carry the same pair. Two decoded traces that both
+/// say `pid 0, tid 0` are therefore indistinguishable once concatenated -- every slice
+/// claims the same track -- which is why a multi-hart capture could not be merged before.
+///
+/// A single-trace decode has exactly one track and no reason to name it, so
+/// [`PerfettoTrack::default`] is `pid 0 / tid 0` with `label: None`, and `label: None`
+/// suppresses the metadata events entirely. That is byte for byte what this receiver
+/// emitted before multi-hart support existed, and it is what `--encoded-trace` still uses.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PerfettoTrack {
+    pub pid: u64,
+    pub tid: u64,
+    /// Human-readable track name, supplied by the caller (`--trace FILE:HART:LABEL`).
+    /// `None` means "emit no metadata at all", not "emit an empty name".
+    pub label: Option<String>,
+    /// Where this track's own single-hart JSON file goes.
+    pub path: PathBuf,
+}
+
+impl Default for PerfettoTrack {
+    fn default() -> Self {
+        PerfettoTrack {
+            pid: 0,
+            tid: 0,
+            label: None,
+            path: PathBuf::from("trace.perfetto.json"),
+        }
+    }
+}
+
+impl PerfettoTrack {
+    /// A named track for one hart, writing its own file at `path`.
+    pub fn hart(hart: u64, label: String, path: PathBuf) -> Self {
+        PerfettoTrack { pid: hart, tid: hart, label: Some(label), path }
+    }
+
+    /// The `M`-phase metadata that names this track in the Perfetto UI. Empty when the
+    /// track is unnamed, which is what keeps the single-trace output unchanged.
+    pub fn metadata(&self) -> Vec<String> {
+        match &self.label {
+            None => Vec::new(),
+            Some(name) => ["process_name", "thread_name"]
+                .iter()
+                .map(|which| {
+                    json!({
+                        "name": which,
+                        "ph": "M",
+                        "pid": self.pid,
+                        "tid": self.tid,
+                        "args": { "name": name }
+                    })
+                    .to_string()
+                })
+                .collect(),
+        }
+    }
+}
+
+/// Where a track's events go when several traces are decoded into one timeline.
+/// `(order, events)`: the order is the position of the `--trace` argument that produced
+/// them, so the merged file is written in the order the caller asked for regardless of
+/// which decode finished first.
+pub type MergedSink = Arc<Mutex<Vec<(usize, Vec<String>)>>>;
+
+/// Write a Chrome/Perfetto `traceEvents` object.
+///
+/// Factored out so the merged file and the per-hart files are produced by the same code.
+/// The framing (two-space indent, four-space event indent, trailing blank line) is the
+/// original one, and with an empty `metadata` this emits the same bytes it always did.
+pub fn write_trace_events<W: Write>(w: &mut W, metadata: &[String], events: &[String]) -> std::io::Result<()> {
+    writeln!(w, "{{")?;
+    writeln!(w, "  \"traceEvents\": [")?;
+    let n = metadata.len() + events.len();
+    for (i, ev) in metadata.iter().chain(events.iter()).enumerate() {
+        let comma = if i + 1 < n { "," } else { "" };
+        writeln!(w, "    {}{}", ev, comma)?;
+    }
+    writeln!(w, "  ]")?;
+    writeln!(w, "}}\n")?;
+    Ok(())
+}
+
 /// A Chrome Tracing (Perfetto) JSON receiver for RISC‑V trace decoding,
 /// but using the unwinder’s stack as the ground truth.
 pub struct PerfettoReceiver {
@@ -17,20 +105,35 @@ pub struct PerfettoReceiver {
