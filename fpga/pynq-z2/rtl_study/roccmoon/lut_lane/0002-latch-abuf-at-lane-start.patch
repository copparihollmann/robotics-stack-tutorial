+  // `abuf` is the engine's t_abuf, a LIVE wire.  t_abuf is written by `cfg && !t_busy`, and a
+  // lane dispatch does NOT set t_busy -- so a cfg issued while a lane owns the scratchpad
+  // re-points that lane's reads to the other buffer MID-STREAM, silently, with no error bit.
+  // A pipelined harness must write cfg to flip buffers between tiles, so it meets this hazard
+  // by construction.  Latching the buffer at the start of a lane dispatch costs one flip-flop
+  // and removes it for all three lanes.
+  reg own_abuf;
+  always @(posedge clk) if (own == 2'd0) own_abuf <= abuf;
+  wire l_abuf = (own == 2'd0) ? abuf : own_abuf;
+
   wire attn_on = (own == 2'd1);
   wire ln_on   = (own == 2'd2);
   wire lut_on  = (own == 2'd3);
