+/// Which TACIT encoder produced the stream.
+///
+/// The RTL encoder (generators/tacit, TacitEncoder.scala) and Spike's software encoder
+/// (riscv-isa-sim, trace_encoder_l.cc) do not emit the same sync and trap packets. Spike
+/// added a privilege byte, a context varint and a runtime-config byte; the RTL encoder's
+/// packetizer emits only [header][trap_addr][target_addr][timestamp], with trap_addr
+/// present only on traps. Every other packet type is identical, so one flag covers it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Encoder {
+    /// riscv-isa-sim trace_encoder_l: sync/trap carry prv (+ ctx, +runtime_cfg).
+    Spike,
+    /// generators/tacit TacitEncoder.scala: no prv, no ctx, no runtime_cfg.
+    Rtl,
+}
+
+impl Encoder {
+    pub fn parse(s: &str) -> Result<Encoder> {
+        match s {
+            "spike" | "sim" => Ok(Encoder::Spike),
+            "rtl" | "hw" | "fpga" => Ok(Encoder::Rtl),
+            other => Err(anyhow::anyhow!(
+                "unknown --encoder `{}` (expected `spike` or `rtl`)", other)),
+        }
+    }
+}
+
