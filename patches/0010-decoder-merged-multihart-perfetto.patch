+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    // The default track is the single-trace contract: pid 0, tid 0, no metadata. If this
+    // ever changes, every `--encoded-trace` decode in the repo changes with it, including
+    // the one expected/tacit.json goldens.
+    #[test]
+    fn default_track_is_pid0_tid0_unnamed() {
+        let t = PerfettoTrack::default();
+        assert_eq!((t.pid, t.tid), (0, 0));
+        assert_eq!(t.label, None);
+        assert!(t.metadata().is_empty());
+        assert_eq!(t.path, PathBuf::from("trace.perfetto.json"));
+    }
+
+    #[test]
+    fn named_track_emits_both_metadata_events() {
+        let t = PerfettoTrack::hart(1, "hart 1 (LITTLE)".into(), PathBuf::from("h1.json"));
+        assert_eq!((t.pid, t.tid), (1, 1));
+        let m = t.metadata();
+        assert_eq!(m.len(), 2);
+        // serde_json without `preserve_order` sorts object keys, which is what makes the
+        // decoder's output stable enough for the labs to regex it.
+        assert_eq!(
+            m[0],
+            r#"{"args":{"name":"hart 1 (LITTLE)"},"name":"process_name","ph":"M","pid":1,"tid":1}"#
+        );
+        assert_eq!(
+            m[1],
+            r#"{"args":{"name":"hart 1 (LITTLE)"},"name":"thread_name","ph":"M","pid":1,"tid":1}"#
+        );
+    }
+
+    // The framing is load-bearing: expected/tacit.json counts `"ph":"B"` occurrences in a
+    // file written by this function, and 10_tacit_hello.sh reproduces it bit-exactly.
+    #[test]
+    fn framing_without_metadata_is_the_original_one() {
+        let mut buf: Vec<u8> = Vec::new();
+        write_trace_events(&mut buf, &[], &["{\"a\":1}".into(), "{\"b\":2}".into()]).unwrap();
+        assert_eq!(
+            String::from_utf8(buf).unwrap(),
+            "{\n  \"traceEvents\": [\n    {\"a\":1},\n    {\"b\":2}\n  ]\n}\n\n"
+        );
+    }
+
+    #[test]
+    fn metadata_is_counted_by_the_comma_placement() {
+        let mut buf: Vec<u8> = Vec::new();
+        write_trace_events(&mut buf, &["{\"m\":0}".into()], &["{\"a\":1}".into()]).unwrap();
+        assert_eq!(
+            String::from_utf8(buf).unwrap(),
+            "{\n  \"traceEvents\": [\n    {\"m\":0},\n    {\"a\":1}\n  ]\n}\n\n"
+        );
+    }
+
+    #[test]
+    fn empty_trace_still_closes_the_array() {
+        let mut buf: Vec<u8> = Vec::new();
+        write_trace_events(&mut buf, &[], &[]).unwrap();
+        assert_eq!(String::from_utf8(buf).unwrap(), "{\n  \"traceEvents\": [\n  ]\n}\n\n");
+    }
+}
