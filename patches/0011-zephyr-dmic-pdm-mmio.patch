+# Copyright (c) 2026 IISWC tutorial
+# SPDX-License-Identifier: Apache-2.0
+
+description: |
+  PDM microphone front end in the PL of a PYNQ-Z1.
+
+  A CIC + FIR decimator that turns the 1-bit bitstream of the board's Knowles
+  SPK0833LM4H-B into 16-bit PCM and buffers it in a hardware FIFO.  The PCM sample
+  rate is fixed by the SoC clock and the decimation ratios, and is reported by the
+  RATE register in millihertz -- it is NOT exactly 16 kHz.  See
+  fpga/pynq-z2/docs/MICROPHONE.md.
+
+compatible: "iiswc,pdm-mic"
+
+include: base.yaml
+
+properties:
+  reg:
+    required: true
+
+  interrupts:
+    required: false
+    description: |
+      Optional level interrupt, asserted while the FIFO level is at or above the
+      watermark register.  The driver polls if this is absent.
