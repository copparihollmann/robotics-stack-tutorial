+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn spec_defaults_hart_to_position_and_label_to_hart() {
+        let s = parse_trace_spec("out/hart0/tacit.out", 0).unwrap();
+        assert_eq!(s, TraceSpec { path: "out/hart0/tacit.out".into(), hart: 0, label: "hart 0".into() });
+        let s = parse_trace_spec("out/hart1/tacit.out", 1).unwrap();
+        assert_eq!(s.hart, 1);
+        assert_eq!(s.label, "hart 1");
+    }
+
+    #[test]
+    fn spec_takes_an_explicit_hart_and_label() {
+        let s = parse_trace_spec("a/b.out:3:hart 3 (big, MBP)", 0).unwrap();
+        assert_eq!(s.path, "a/b.out");
+        assert_eq!(s.hart, 3);
+        assert_eq!(s.label, "hart 3 (big, MBP)");
+    }
+
+    // The label is everything after the second colon, so a label may contain one.
+    #[test]
+    fn label_may_contain_colons() {
+        let s = parse_trace_spec("a.out:1:LITTLE: no MBP", 0).unwrap();
+        assert_eq!(s.label, "LITTLE: no MBP");
+    }
+
+    #[test]
+    fn spec_rejects_a_non_numeric_hart() {
+        assert!(parse_trace_spec("a.out:big", 0).is_err());
+        assert!(parse_trace_spec("", 0).is_err());
+    }
