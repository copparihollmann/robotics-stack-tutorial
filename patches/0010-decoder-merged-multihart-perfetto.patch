+/// Decode every `--trace` in turn and write one Perfetto file containing all of them.
+///
+/// Sequential, not parallel: each decode owns a `Bus` and a fixed set of receiver threads,
+/// and the traces are small next to the ELF parse. Doing them one at a time also means the
+/// merged file is assembled in a defined order without any cross-decode locking beyond the
+/// sink itself.
+///
+/// TIMEBASE. Nothing here rescales a timestamp. TACIT stamps packets with deltas in CORE
+/// CYCLES, so putting two harts on one axis is only meaningful when their `mcycle`s are
+/// the same clock -- on Rocket that needs patches/0004-rocketchip-mcycle-free-run.patch,
+/// without which an idle hart's counter stops in `wfi` and the two tracks come out
+/// millions of cycles apart. See fpga/pynq-z2/docs/TACIT_MULTICORE.md.
+fn decode_many(args: &Args) -> Result<()> {
+    let specs: Vec<TraceSpec> = args.trace.iter().enumerate()
+        .map(|(i, a)| parse_trace_spec(a, i))
+        .collect::<Result<_>>()?;
+
+    if args.encoded_trace.is_some() {
+        return Err(anyhow::anyhow!(
+            "--encoded-trace and --trace are two different modes; pass one or the other"));
+    }
+    if !args.to_perfetto {
+        return Err(anyhow::anyhow!(
+            "--trace merges Perfetto timelines, so it needs --to-perfetto"));
+    }
+    // Every other backend writes a fixed file name into the current directory, which
+    // cannot be right for more than one hart at a time. Rather than silently letting hart
+    // 1 overwrite hart 0, say so.
+    for (flag, on) in [("--to-stats", args.to_stats), ("--to-stack-txt", args.to_stack_txt),
+                       ("--to-atomics", args.to_atomics), ("--to-afdo", args.to_afdo),
+                       ("--to-gcda", args.to_gcda), ("--to-speedscope", args.to_speedscope),
+                       ("--to-vpp", args.to_vpp), ("--to-foc", args.to_foc),
+                       ("--to-vbb", args.to_vbb)] {
+        if on {
+            return Err(anyhow::anyhow!(
+                "{} writes one fixed file name and cannot be combined with --trace; \
+                 decode that hart on its own with --encoded-trace", flag));
+        }
+    }
+    let mut seen: Vec<u64> = Vec::new();
+    for sp in &specs {
+        if seen.contains(&sp.hart) {
+            return Err(anyhow::anyhow!(
+                "hart {} given twice; two traces on one track cannot be told apart", sp.hart));
+        }
+        seen.push(sp.hart);
+    }
+
+    let sink: MergedSink = Arc::new(Mutex::new(Vec::new()));
+    for (i, sp) in specs.iter().enumerate() {
+        // The per-hart outputs land next to the encoded trace, which is where the labs
+        // already keep them ($RUN/hart0/tacit.out -> $RUN/hart0/trace.perfetto.json).
+        let dir = Path::new(&sp.path).parent().unwrap_or(Path::new(".")).to_path_buf();
+        println!("[trace {}] hart {} `{}` <- {}", i, sp.hart, sp.label, sp.path);
+        decode_one(
+            args,
+            &sp.path,
+            Some(dir.join("trace.txt")),
+            PerfettoTrack::hart(sp.hart, sp.label.clone(), dir.join("trace.perfetto.json")),
+            Some((i, Arc::clone(&sink))),
+        )?;
+    }
+
+    let mut blocks = Arc::try_unwrap(sink)
+        .map_err(|_| anyhow::anyhow!("merged sink still shared"))?
+        .into_inner()
+        .map_err(|_| anyhow::anyhow!("merged sink poisoned"))?;
+    blocks.sort_by_key(|(order, _)| *order);
+    let events: Vec<String> = blocks.into_iter().flat_map(|(_, ev)| ev).collect();
+
+    let out = PathBuf::from(&args.merged_perfetto);
+    if let Some(d) = out.parent() {
+        if !d.as_os_str().is_empty() {
+            std::fs::create_dir_all(d)?;
+        }
+    }
+    let mut w = BufWriter::new(File::create(&out)?);
+    // The metadata already rides at the head of each hart's block, so there is nothing
+    // extra to prepend here.
+    write_trace_events(&mut w, &[], &events)?;
+    use std::io::Write as _;
+    w.flush()?;
+    println!("[Success] Merged {} traces ({} events) into {}",
+             specs.len(), events.len(), out.display());
+    Ok(())
+}
+
+fn main() -> Result<()> {
+    env_logger::init();
+    let args = Args::parse();
+
+    if !args.trace.is_empty() {
+        return decode_many(&args);
+    }
+
+    let encoded_trace = args.encoded_trace.clone().ok_or_else(|| anyhow::anyhow!(
+        "no trace to decode: pass --encoded-trace FILE, or --trace FILE[:HART[:LABEL]] \
+         once per hart for a merged multi-hart timeline"))?;
+    decode_one(&args, &encoded_trace, None, PerfettoTrack::default(), None)
+}
