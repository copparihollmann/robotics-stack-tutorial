+// Two pins, straight out to package balls F17 and G18 -- no IOCells, exactly as
+// WithOspiPunchthrough does it for the camera. The structural top in
+// fpga/pynq-z2/src/pynqz2_rocket_top.v is what gives them an IOSTANDARD.
+class WithPdmMicPunchthrough extends OverrideIOBinder({
+  (system: pdmmic.CanHavePeripheryPdmMic) => {
+    val ports = system.pdm_mic.map { micMV =>
+      val mic: pdmmic.PdmMicIO = micMV // unwrap the InModuleBody ModuleValue via the implicit
+      val io_mic = IO(chiselTypeOf(mic)).suggestName("mic")
+      io_mic <> mic
+      PdmMicPort(() => io_mic)
+    }.toSeq
+    (ports, Nil)
+  }
+})
