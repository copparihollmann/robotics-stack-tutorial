+/// Split on ':' at most twice: the path first (so it may not contain a colon), then the
+/// hart id, then everything left is the label (so the label may). `idx` is the argument's
+/// position, used as the hart id when the caller did not give one.
+fn parse_trace_spec(arg: &str, idx: usize) -> Result<TraceSpec> {
+    let mut it = arg.splitn(3, ':');
+    let path = it.next().unwrap_or("").to_string();
+    if path.is_empty() {
+        return Err(anyhow::anyhow!("--trace `{}`: empty trace path", arg));
+    }
+    let hart = match it.next() {
+        Some(h) if !h.is_empty() => h.parse::<u64>().map_err(|_| {
+            anyhow::anyhow!("--trace `{}`: `{}` is not a hart id (expected FILE[:HART[:LABEL]])", arg, h)
+        })?,
+        _ => idx as u64,
+    };
+    let label = match it.next() {
+        Some(l) if !l.is_empty() => l.to_string(),
+        _ => format!("hart {}", hart),
+    };
+    Ok(TraceSpec { path, hart, label })
