#
# THE SHAPE OF THIS FILE IS THE POINT, and it is the shape every in-tree Zephyr driver has.
# Compare drivers/i2c/Kconfig.sifive, which is the driver for the controller this camera's
# sensor is wired to:
#
#     config I2C_SIFIVE
#             bool "SiFive Freedom I2C driver"
#             default y
#             depends on DT_HAS_SIFIVE_I2C0_ENABLED
#
# DT_HAS_<COMPAT>_ENABLED is generated for every compatible string that appears anywhere in
# the devicetree -- 2,871 of them in a build for chipyard_pynqz1_all_f40, in
# <build>/Kconfig/Kconfig.dts -- and is y when at least one node with that compatible has
# status "okay".  So `default y` + `depends on` that symbol means: this driver switches
# itself on exactly when the hardware it drives is declared, and no application, board or
# defconfig has to name it.  DT_HAS_UCBBAR_OSPI_HM01B0_ENABLED has been generated on every
# build of these three boards since the ospi@10080000 node was added; until now nothing
# claimed it.
#
# The I2C dependency is not incidental.  The sensor's control port is I2C address 0x24 on
# the controller the node's `sensor-i2c` phandle names, so the driver cannot bring the part
# up without the I2C framework.  It is a `depends on` rather than a `select` for the same
# reason I2C_SIFIVE's is: the framework is the board's decision -- both boards that carry
# this camera set CONFIG_I2C=y in their _defconfig -- and a driver that forced a subsystem
# on would take that decision away from an image that has no camera in it.

config OSPI_HM01B0
	bool "HM01B0 parallel-video capture unit (ucbbar,ospi-hm01b0)"
	default y
	depends on DT_HAS_UCBBAR_OSPI_HM01B0_ENABLED
	depends on I2C
	help
	  Driver for the Chipyard capture peripheral at ospi@10080000 and the HM01B0 image
	  sensor on its parallel video port: the DMA master that writes one whole frame into
	  DRAM, the MCLK the sensor is clocked from, and the sensor's own registers over the
	  I2C controller the sensor-i2c phandle names.

	  Applications reach it as a Zephyr device:

	      const struct device *cam = DEVICE_DT_GET(DT_ALIAS(camera0));
	      struct ospi_camera_frame f;
	      ospi_camera_capture(cam, buf, sizeof buf, &f);

	  The register sequences are fpga/pynq-z2/sw/cam/ospi_cam.c, which this driver calls
	  rather than reimplements, and which samples/cam_rtl_sim runs unchanged against the
	  RTL in Verilator.

if OSPI_HM01B0

config OSPI_HM01B0_INIT_PRIORITY
	int "Init priority"
	default 60
	help
	  Must be above CONFIG_I2C_INIT_PRIORITY (50), because this driver's init checks that
	  the I2C controller its sensor-i2c phandle names is ready, and a controller whose own
	  init has not run yet is not.

config OSPI_HM01B0_MAX_POLLS
	int "Polls before a capture gives up"
	default 3000
	help
	  ospi_camera_capture() sleeps 1 ms between polls of DMA_STATUS, so this is also the
	  timeout in milliseconds.  It has to be generous: this RTL has no way to abort a
	  transfer, so a capture armed with no pixel clock stays BUSY until the SoC is reset,
	  and the only thing a timeout buys is a console line saying so.

endif # OSPI_HM01B0
